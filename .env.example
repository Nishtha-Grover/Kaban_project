# Copy this file to .env. Never commit .env or real credentials.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Atlas or replica-set connection URI; required for database features.
# Keep credentials server-side. See docs/setup-atlas.md.
MONGODB_URI=
# Generate a random secret of at least 32 characters; never reuse a sample secret.
JWT_SECRET=
