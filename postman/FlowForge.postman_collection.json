                ]
              }
            }
          ]
        },
        {
          "name": "02 Upload sample TXT — select file first",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{uploadTaskId}}/attachments",
            "description": "Run in the documented order against a disposable test database.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": null,
                  "description": "Choose postman/fixtures/notes.txt in Postman before sending."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"attachmentId\", pm.response.json().attachment.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Download attachment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{uploadTaskId}}/attachments/{{attachmentId}}/download",
            "description": "Run in the documented order against a disposable test database."
